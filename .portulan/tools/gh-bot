#!/usr/bin/env bash
# Run a `gh` command as the agent identity, for pull-request conversation only.
# Exit 2 when this refuses or is misconfigured, so neither reads as a GitHub refusal.

set -uo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 2
command -v gh >/dev/null 2>&1 || { printf 'gh-bot: the gh CLI is not installed\n' >&2; exit 2; }
command -v node >/dev/null 2>&1 || { printf 'gh-bot: node is not installed\n' >&2; exit 2; }

if [ "$#" -eq 0 ]; then
    printf 'gh-bot: usage: %s <gh arguments…>\n' "${BASH_SOURCE[0]}" >&2
    printf '        e.g. %s api repos/OWNER/REPO/issues/1/comments -f body=hello\n' "${BASH_SOURCE[0]}" >&2
    exit 2
fi

# A guard against habit, not a security boundary: the App's permission set bounds the token.
# `gh pr` is refused with a pointer to the API form, so an agent does not fall back to plain `gh` as the maintainer.
case "${1:-}" in
    pr)
        printf 'gh-bot: use the API form so the action is unambiguous, e.g.\n' >&2
        printf '        %s api repos/OWNER/REPO/issues/N/comments -f body=...\n' "${BASH_SOURCE[0]}" >&2
        printf '        %s api repos/OWNER/REPO/pulls/N/comments/ID/replies -f body=...\n' "${BASH_SOURCE[0]}" >&2
        printf '        (`gh pr` also covers merge and close, which are the maintainer'"'"'s — see ../gate-map.md.)\n' >&2
        exit 2
        ;;
    repo|release|auth|secret|ssh-key|gpg-key)
        printf 'gh-bot: `gh %s` is not for the agent identity — see ../gate-map.md, "Which identity acts"\n' "$1" >&2
        exit 2
        ;;
    api)
        # The endpoint is the first argument that is neither a flag nor the value of an option that takes one.
        endpoint=""
        skip=0
        for arg in "${@:2}"; do
            if [ "$skip" -eq 1 ]; then skip=0; continue; fi
            case "$arg" in
                -X|--method|-F|--field|-f|--raw-field|-H|--header|-q|--jq|-t|--template|--cache|--hostname|-p|--preview|--input)
                    skip=1 ;;
                -*) ;;
                *) endpoint="$arg"; break ;;
            esac
        done
        endpoint="${endpoint#/}"

        # Each segment is `[^/]+` and the pattern is anchored, so no entry admits a subtree; the App's permission set bounds `graphql`.
        conversation='^(graphql'
        conversation+='|installation/repositories'
        conversation+='|repos/[^/]+/[^/]+/issues/[0-9]+/comments'
        conversation+='|repos/[^/]+/[^/]+/issues/comments/[0-9]+'
        conversation+='|repos/[^/]+/[^/]+/pulls/[0-9]+/comments'
        conversation+='|repos/[^/]+/[^/]+/pulls/[0-9]+/comments/[0-9]+/replies'
        conversation+='|repos/[^/]+/[^/]+/pulls/[0-9]+/reviews(/[0-9]+(/comments)?)?'
        conversation+='|repos/[^/]+/[^/]+/pulls/comments/[0-9]+'
        conversation+=')$'

        # An endpoint the scan could not identify is refused, never admitted, `--help` included.
        if ! [[ "$endpoint" =~ $conversation ]]; then
            # An if/else, since `${endpoint:+…}${endpoint:-…}` prints the endpoint twice when it is set.
            if [ -n "$endpoint" ]; then shown="\`$endpoint\`"; else shown="<no endpoint found in these arguments>"; fi
            printf 'gh-bot: this identity is for PULL REQUEST CONVERSATION, and %s is not one of its endpoints.\n' "$shown" >&2
            printf '        Allowed: issue/review comments, review replies, reviews, `graphql`, `/installation/repositories`.\n' >&2
            printf '        Settings — rulesets, branch protection, collaborators — are not this identity'"'"'s, and the\n' >&2
            printf '        two halves differ. A CHANGE there GitHub refuses anyway: this App holds no `administration`.\n' >&2
            printf '        A READ it may NOT refuse — a ruleset read rides on `metadata` and answers 200 — and this\n' >&2
            printf '        script refuses that by choice, which is where it is narrower than the policy.\n' >&2
            printf '        The maintainer reaches both with plain `gh api`. See ../gate-map.md, "The honest holes".\n' >&2
            exit 2
        fi
        ;;
esac

token=$(node "$here/gh-bot-token.mjs") || exit $?
[ -n "$token" ] || { printf 'gh-bot: empty token\n' >&2; exit 2; }

GH_TOKEN="$token" exec gh "$@"
