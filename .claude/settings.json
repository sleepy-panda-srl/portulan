{
  "$portulan": {
    "generated": "cli/compile.mjs",
    "source": ".portulan/gates.json",
    "packs": [
      {
        "pack": "rituals/checkpoints",
        "origin": "tree",
        "version": "0.3.0"
      },
      {
        "pack": "tools/github",
        "origin": "tree",
        "version": "0.1.0"
      }
    ],
    "warning": "Generated file. Edit .portulan/gates.json and recompile; `verify/compile.sh` fails on drift."
  },
  "permissions": {
    "deny": [],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push --delete:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(git tag:*)",
      "Bash(gh release:*)",
      "Bash(npm publish:*)"
    ],
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/cli/gate.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/cli/stop-gate.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/cli/advisory.mjs\" tool"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/cli/advisory.mjs\" prompt"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR}/cli/advisory.mjs\" status"
  }
}
